---
/**
 * A button, or a link that looks like one. At least 48 px tall.
 * The words go in the slot; they always come from the translation files.
 *
 * <Button href={event.signup_url} icon="external" external>{t("listing.go_button.signup")}</Button>
 * <Button variant="secondary" icon="calendar" href={icsUrl} download>{t("listing.add_to_calendar")}</Button>
 * <Button type="submit">{t("email_signup.submit")}</Button>
 */
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

type Props = {
  /** primary: filled main colour (navy), the one main action on a screen. secondary: outlined. quiet: text only. */
  variant?: "primary" | "secondary" | "quiet";
  /** With href the button is a link (<a>); without, a <button>. */
  href?: string;
  /** Opens the organization's site. Adds rel="noopener" and the external icon. */
  external?: boolean;
  icon?: IconName;
  /** Icon after the words instead of before. */
  iconEnd?: boolean;
  /** Stretch to the full width of its container (good on phones). */
  block?: boolean;
  type?: "button" | "submit" | "reset";
  class?: string;
} & Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "type" | "class">;

const {
  variant = "primary",
  href,
  external = false,
  icon,
  iconEnd = false,
  block = false,
  type = "button",
  class: className,
  ...rest
} = Astro.props;

const iconName: IconName | undefined = icon ?? (external ? "external" : undefined);
const classes = ["btn", `btn--${variant}`, block && "btn--block", className];
---

{
  href ? (
    <a class:list={classes} href={href} rel={external ? "noopener" : undefined} {...rest}>
      {iconName && !iconEnd && !external && <Icon name={iconName} />}
      <span><slot /></span>
      {iconName && (iconEnd || external) && <Icon name={iconName} />}
    </a>
  ) : (
    <button class:list={classes} type={type} {...rest}>
      {iconName && !iconEnd && <Icon name={iconName} />}
      <span><slot /></span>
      {iconName && iconEnd && <Icon name={iconName} />}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: var(--space-2) var(--space-5);
    border: var(--border) solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--text-body);
    font-weight: var(--weight-strong);
    line-height: var(--leading-tight);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--speed), border-color var(--speed);
  }
  .btn--block {
    display: flex;
    width: 100%;
  }
  .btn--primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .btn--primary:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
  }
  .btn--secondary {
    background: var(--color-surface);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .btn--secondary:hover {
    background: var(--color-paper);
    color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }
  .btn--quiet {
    background: transparent;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    justify-content: flex-start;
    text-align: left;
    padding-inline: 0;
  }
  .btn:disabled,
  .btn[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: 0.6;
  }
  @media (forced-colors: active) {
    .btn {
      border-color: ButtonText;
    }
  }
</style>
