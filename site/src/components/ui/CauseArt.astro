---
/**
 * The picture area of a listing: the drawing for the listing's cause.
 * The drawings themselves are on the page once, in <SvgSprite />
 * (put it once in the layout). This component only points to one, so a
 * page of 300 cards stays small.
 *
 * Decorative: the card's words say everything, so screen readers skip it.
 * Unknown or missing causes get the fallback drawing (causeArt.ts).
 *
 * <CauseArt cause={event.cause} />
 */
import { artId } from "./causeArt";

interface Props {
  /** A cause id from the settings file, or null. */
  cause?: string | null;
  class?: string;
}

const { cause, class: className } = Astro.props;
const id = artId(cause);
---

<div class:list={["cause-art", className]} style={`--art-bg: var(--art-${id});`} data-cause={id} aria-hidden="true">
  <svg viewBox="0 0 320 150"><use href={`#cause-art-${id}`} /></svg>
</div>

<style is:global>
  /* Global (not scoped) so each card's drawing stays small. */
  .cause-art {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--art-bg, var(--art-default));
  }
  .cause-art svg {
    width: 100%;
    height: 100%;
  }
  @media (forced-colors: active) {
    .cause-art {
      forced-color-adjust: none;
    }
  }
</style>
